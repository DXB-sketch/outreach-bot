# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible endpoint (e.g. freellmapi.co). Check your provider's docs for the base URL.
LLM_BASE_URL=https://example-provider/v1
LLM_API_KEY=
# Comma-separated fallback lists: the first model is tried first, the next on rate limits or errors.
LLM_FAST_MODELS=
LLM_STRONG_MODELS=
# Minimum seconds between LLM calls (keeps you under rate limits).
LLM_MIN_INTERVAL=2

# Optional, for much better local coverage than OpenStreetMap. Also used by find-websites to look up
# each business's website and review count. Check Google's pricing first.
GOOGLE_PLACES_API_KEY=
# Optional web search used by find-websites when Places isn't set or has no website. Check Brave's pricing.
BRAVE_API_KEY=

# Extra categories or name words to never target, comma-separated (e.g. real estate,florist).
# Hotels, motels, lawyers, hospitals, schools, councils, chains etc. are excluded already.
EXCLUDE_KEYWORDS=

# JavaScript rendering for Wix/Squarespace-style sites and sites that block plain HTTP clients.
# Needs: pip install -e ".[browser]" && playwright install chromium. Set to off to disable.
RENDER_JS=auto
# PLAYWRIGHT_CHROMIUM_PATH=/path/to/chrome   (only if Playwright can't find its own Chromium)

# Used in drafts and in the crawler's User-Agent so site owners can identify you.
SENDER_NAME=
SENDER_BUSINESS=Monolith Web Studio
SENDER_EMAIL=
SENDER_PHONE=
SENDER_WEBSITE=
SENDER_LOCATION=Wamuran, QLD

SCORE_THRESHOLD=60
OUTREACH_DATA_DIR=data
